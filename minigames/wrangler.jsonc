// Cloudflare Workers Builds chạy "npx wrangler deploy" với file này mỗi lần push lên main.
// Bản clone (quà Móc khoá/Nón/Bình nước/Túi) → Worker "minigames". Build: Root directory = minigames
// - public/  : giao diện game (index.html) + trang quản trị (admin.html)
// - worker/  : API dưới /api, lưu dữ liệu vào D1 "vong-quay"
{
  "name": "minigames",
  "main": "worker/worker.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vong-quay",
      "database_id": "ce2c475f-59a9-4926-941b-34e147e385b2"
    }
  ],
  // giữ các biến đặt trên dashboard (vd SHEET_WEBHOOK) khi deploy lại; ADMIN_KEY đặt dạng Secret
  "keep_vars": true,
  "observability": { "enabled": true }
}
